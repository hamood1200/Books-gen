{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/book/**",
              "ui_kits/guide-book/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Madani Arabic|Tinos|Fira Sans))/i]",
        "message": "Font not provided by the design system. Available: Madani Arabic, Tinos, Fira Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorBio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|photoSrc|children|style|key|ref|className|style|children)$/]",
        "message": "<AuthorBio> doesn't accept that prop. Declared props: label, photoSrc, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|indent|size|style|lang|key|ref|className|style|children)$/]",
        "message": "<BodyText> doesn't accept that prop. Declared props: children, align, indent, size, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:justify|left|center|right)$/]",
        "message": "<BodyText> align must be one of 'justify' | 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<BodyText> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|byline|blurb|note|edition|year|photoSrc|logoSrc|style|lang|key|ref|className|style|children)$/]",
        "message": "<BookCover> doesn't accept that prop. Declared props: title, byline, blurb, note, edition, year, photoSrc, logoSrc, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCover'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<BookCover> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|page|side|title|author|logoSrc|watermarkSrc|tint|style|lang|key|ref|className|style|children)$/]",
        "message": "<BookPage> doesn't accept that prop. Declared props: children, page, side, title, author, logoSrc, watermarkSrc, tint, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookPage'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:recto|verso)$/]",
        "message": "<BookPage> side must be one of 'recto' | 'verso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookPage'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<BookPage> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|marker|numbered|style|lang|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, marker, numbered, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<BulletList> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|captionPosition|frame|style|lang|key|ref|className|style|children)$/]",
        "message": "<FigureBlock> doesn't accept that prop. Declared props: src, alt, caption, captionPosition, frame, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureBlock'] > JSXAttribute[name.name='captionPosition'] > Literal[value!=/^(?:above|below)$/]",
        "message": "<FigureBlock> captionPosition must be one of 'above' | 'below'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureBlock'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<FigureBlock> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFolio'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|style|key|ref|className|style|children)$/]",
        "message": "<PageFolio> doesn't accept that prop. Declared props: page, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartOpener'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|photoSrc|style|key|ref|className|style|children)$/]",
        "message": "<PartOpener> doesn't accept that prop. Declared props: title, author, photoSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunningHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:side|title|author|logoSrc|style|lang|key|ref|className|style|children)$/]",
        "message": "<RunningHeader> doesn't accept that prop. Declared props: side, title, author, logoSrc, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunningHeader'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:recto|verso)$/]",
        "message": "<RunningHeader> side must be one of 'recto' | 'verso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunningHeader'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<RunningHeader> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|width|align|style|lang|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, width, align, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<SectionHeading> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecTableRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:group|cells|key|ref|className|style|children)$/]",
        "message": "<SpecTableRow> doesn't accept that prop. Declared props: group, cells."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|lang|key|ref|className|style|children)$/]",
        "message": "<SubHeading> doesn't accept that prop. Declared props: children, tone, style, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:orange|crimson|teal)$/]",
        "message": "<SubHeading> tone must be one of 'orange' | 'crimson' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubHeading'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:en|ar)$/]",
        "message": "<SubHeading> lang must be one of 'en' | 'ar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|page|key|ref|className|style|children)$/]",
        "message": "<TocEntry> doesn't accept that prop. Declared props: title, page."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
